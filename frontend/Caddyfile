{$DOMAIN:localhost} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		root * /srv

		# index.html changes on every deploy without its own filename ever
		# changing, so it must always be revalidated — otherwise a client
		# (notably the Android app's WebView, which loads the page exactly
		# once per app launch and never reloads it — see WebTabScreen.kt)
		# can keep serving a stale index.html that points at JS/CSS bundle
		# filenames no longer on the server, indefinitely.
		header Cache-Control "no-cache"

		# Vite fingerprints every filename under /assets with a content
		# hash, so unlike index.html these never change without also
		# changing name — safe to cache for a year.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
