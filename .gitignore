# OS
.DS_Store

# Local tool/editor config (not shared)
.claude/
.idea/

# Env files with real secrets (only .env.example is committed)
.env
.env.local

# Production DB backups (backup.sh on the server dumps here) — never
# commit real data dumps, especially since this repo is public.
/backups/

# Go
backend/*.exe
backend/wealthfolio-api

# Node (frontend has its own .gitignore too, this covers root-level runs)
node_modules/
dist/
